ARG PLATFORM=linux/amd64
FROM --platform=${PLATFORM} condaforge/miniforge3:24.11.3-0

# Create a conda environment and install python
RUN conda create -n valiant python=3.11 -y && \
    conda clean -afy

# Activate the conda environment
ENV PATH /opt/conda/envs/valiant/bin:$PATH

# Install dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends procps && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Install valiant package
COPY VaLiAnT/pyproject.toml VaLiAnT/setup.cfg .
COPY VaLiAnT/src/ src/
RUN pip install --no-cache-dir . && \
    rm -rf pyproject.toml setup.cfg src/
